<UserControl x:Class="MistralCodingAssistant.MistralCodingAssistantSideTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MyToolWindow">
    <Grid Margin="10">
        <TabControl x:Name="MainTabs">

            <!-- CHAT TAB -->
            <TabItem Header="Chat">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ChatOutput"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Foreground="White"/>
                    </ScrollViewer>

                    <TextBox x:Name="ChatInput"
                             Grid.Row="1"
                             Height="30"
                             Margin="0,10,0,5"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Foreground="White"
                             Background="#252526"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             BorderBrush="#3C3C3C"/>

                    <Button Grid.Row="2"
                            Content="Send"
                            Width="120"
                            Height="32"
                            HorizontalAlignment="Left"
                            Click="ChatSend_Click"/>
                </Grid>
            </TabItem>

            <!-- CODE ACTIONS TAB -->
            <TabItem Header="Code Actions">
                <StackPanel Margin="10" Orientation="Vertical">
                    <TextBlock Text="Run actions on selected code:"
                               FontSize="14"
                               Foreground="White" />

                    <Button Content="Explain Selection"
                            Margin="0,10,0,0"
                            Height="32"
                            Click="ExplainSelection_Click"/>

                    <Button Content="Optimize Code"
                            Margin="0,10,0,0"
                            Height="32"
                            Click="OptimizeSelection_Click"/>

                    <Button Content="Fix Errors"
                            Margin="0,10,0,0"
                            Height="32"
                            Click="FixSelection_Click"/>

                </StackPanel>
            </TabItem>

            <!-- HISTORY TAB -->
            <TabItem Header="History">
                <ScrollViewer Margin="10">
                    <TextBlock x:Name="HistoryLog"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem Header="Settings">
                <StackPanel Margin="10">
                    <TextBlock Text="AI Model:"
                               FontSize="14"
                               Foreground="White" />
                    <ComboBox x:Name="ModelSelector"
                              Width="200"
                              Margin="0,10,0,0">
                        <ComboBoxItem Content="devstral:24b"/>
                        <ComboBoxItem Content="qwen2.5:7b-instruct"/>
                        <ComboBoxItem Content="mistral"/>
                    </ComboBox>

                    <TextBlock Text="Temperature:"
                               Margin="0,20,0,5"
                               Foreground="White"/>

                    <Slider x:Name="TemperatureSlider"
                            Minimum="0.0" Maximum="1.0"
                            Value="0.2" Width="200"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
